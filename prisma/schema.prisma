generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────
// Auth.js (NextAuth) required models
// These match the shape the Prisma adapter expects.
// We're using Credentials + JWT sessions for now, so `Session`
// won't be actively used yet, but keeping it means adding an
// OAuth provider later requires zero schema changes.
// ─────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────────────────
// Core application models
// ─────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  // Nullable because OAuth users (future) won't have a local password.
  passwordHash  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts Account[]
  sessions Session[]

  workspaceMemberships WorkspaceMember[]
  assignedTasks        Task[]            @relation("TaskAssignee")
  comments             Comment[]
}

model Workspace {
  id   String @id @default(cuid())
  name String
  // URL-friendly identifier, e.g. /workspaces/acme-corp instead of a raw cuid.
  slug String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  WorkspaceMember[]
  projects Project[]
  labels   Label[]
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

// Explicit join model (not an implicit Prisma m2m) because it carries
// data beyond the relationship itself: the member's role.
model WorkspaceMember {
  id          String        @id @default(cuid())
  userId      String
  workspaceId String
  role        WorkspaceRole @default(MEMBER)

  createdAt DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // A user can only have one membership row per workspace.
  @@unique([userId, workspaceId])
  // Speeds up "does this user belong to this workspace" checks,
  // which is the single most frequent query pattern in the app.
  @@index([workspaceId])
}

model Project {
  id          String  @id @default(cuid())
  name        String
  description String?

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks Task[]

  @@index([workspaceId])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  COMPLETED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Optional: an unassigned task is valid. If the assignee is removed
  // from the system, we unassign the task rather than deleting it.
  assigneeId String?
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments Comment[]
  labels   TaskLabel[]

  @@index([projectId])
  @@index([assigneeId])
  @@index([status])
}

model Label {
  id    String @id @default(cuid())
  name  String
  // Hex color for the label chip in the UI, e.g. "#EF4444".
  color String @default("#6B7280")

  // Labels are scoped to a workspace (reused across its projects),
  // not global and not per-project.
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  tasks TaskLabel[]

  @@unique([workspaceId, name])
}

// Explicit join model for Task <-> Label. Plain implicit m2m would work
// today, but this leaves room to later record who attached a label and
// when, without a migration that changes the relationship shape.
model TaskLabel {
  taskId  String
  labelId String

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([taskId, labelId])
}

model Comment {
  id      String @id @default(cuid())
  content String

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  // If the author's account is deleted, keep the comment but drop the
  // link — losing someone else's task history isn't the right default.
  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId])
}
